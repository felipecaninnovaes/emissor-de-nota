# Copie para .env (mesma pasta do compose.yaml) e preencha. Gere segredos com: openssl rand -hex 32

# Domínio do painel (aponte o DNS para a VPS). Usado pelo Caddy (profile https) e na conferência dos formulários.
DOMINIO=backup.exemplo.com.br
URL_PUBLICA=https://backup.exemplo.com.br

# Login do painel. Senha com pelo menos 12 caracteres.
ADMIN_USUARIO=admin
ADMIN_SENHA=

# Senha do Postgres do painel.
POSTGRES_SENHA=

# Credenciais internas do S3 (versitygw). Só o painel usa; o aplicativo nunca vê.
S3_CHAVE=
S3_SEGREDO=

# Backups guardados por cliente (os mais antigos são apagados) e tamanho máximo de cada um.
MANTER_BACKUPS=30
TAMANHO_MAXIMO_MB=500

# Versão da imagem do painel (latest ou uma versão publicada, ex.: 0.1.0).
VERSAO_PAINEL=latest

# Porta do painel na VPS (só 127.0.0.1). Mude se a 8080 já estiver em uso.
PORTA_PAINEL=8080

# false só para testar sem HTTPS (http://localhost): o navegador não guarda cookie Secure em http.
COOKIE_SEGURO=true
