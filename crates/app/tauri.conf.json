{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emissor NFS-e",
  "identifier": "br.emissor-nfse.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Emissor de NFS-e",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Felipe Canin Novaes",
    "shortDescription": "Emissor de NFS-e Padrão Nacional para escritório contábil",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "copyright": "Copyright (c) 2026 Felipe Canin Novaes — Licença MIT",
    "category": "Business"
  }
}
