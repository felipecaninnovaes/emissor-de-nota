{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emissor NFS-e",
  "identifier": "br.emissor-nfse.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Emissor de NFS-e",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Felipe Canin Novaes",
    "shortDescription": "Emissor de NFS-e Padrão Nacional para uma ou várias empresas",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "copyright": "Copyright (c) 2026 Felipe Canin Novaes — Licença AGPL-3.0",
    "category": "Business",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNEQ5RTRBMkE5OTcwNzEKUldSeGNKa3FTcDVOOG83dnN2RStzMk5VdGNpczc3ZjArOTY4RU1XV28xdWthNFlKbXI0VTh3ZUsK",
      "endpoints": [
        "https://github.com/felipecaninnovaes/emissor-de-nota/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
